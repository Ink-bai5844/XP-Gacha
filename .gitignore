# Privacy boundary: keep credentials and user data out of Git.
# This does not protect tracked files, Git history, `git add -f`, Docker build
# contexts, or manually uploaded Release attachments. Audit those separately.

# Credentials and machine-specific configuration (at any directory depth).
.env
.env.*
*.env
*.env.*
.envrc
.npmrc
.pypirc
.netrc
secrets.toml
secrets.json
credentials.json
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
config.local.*
*.local.json
*.local.yaml
*.local.yml
# Reviewed public templates only; never enter real credentials in these files.
!.env.example
!*.env.example
!/portable/portable-settings.env

# Local editor / assistant state can contain prompts, paths and credentials.
/.streamlit/
/.vscode/
/.idea/
/.codex/
/.claude/
/.agents/
/PROMPT

# User library, history, preferences, databases, images and model caches.
/data/
/datacache/
/b64_cache/
/b64_tmp/
/localimgtmp/
/onlineimgtmp/
/manga_vectors/
/models/
/mysql/
/config/
/run/
/logs/
/tmp/
/updates/
/library/
/output1/
/backups/
/exports/
/releases/
/dist/
/build/

# Only empty templates are public. Normal-name runtime dictionaries stay local.
/dictionaries/*
!/dictionaries/STOP_TAGS_empty.txt
!/dictionaries/SEMANTIC_MAP_empty.json
!/dictionaries/TITLE_STOP_WORDS_empty.txt
!/dictionaries/TITLE_SEMANTIC_MAP_empty.json

# Also protect state when portable_launcher.py is run from the source tree.
/portable/.streamlit/
/portable/data/
/portable/datacache/
/portable/b64_cache/
/portable/b64_tmp/
/portable/localimgtmp/
/portable/onlineimgtmp/
/portable/manga_vectors/
/portable/models/
/portable/mysql/
/portable/config/
/portable/run/
/portable/logs/
/portable/tmp/
/portable/updates/
/portable/library/
/portable/runtime/
/portable/dictionaries/

# Recognizable state remains private if saved outside the default directories.
recommendation_history.json*
ui-preferences.json*
llm-settings.json*
cookies.txt
cookies.json
*.collection.lock
*.csv.updates.jsonl*
*.checkpoint.json*
*.state.jsonl*

# Clash/Mihomo pools contain node credentials, subscriptions and node names.
clash-pool/
/clash/
/mihomo/
/subscriptions/
/profiles/
/proxy-providers/
/proxy_providers/
proxy-pool.json*
proxy_pool.json*
mihomo.yaml*
mihomo.yml*
clash.yaml*
clash.yml*
subscriptions.yaml*
subscriptions.yml*
subscriptions.json*
subscription.yaml*
subscription.yml*
subscription.json*
profiles.yaml*
profiles.yml*
# The example contains loopback addresses only, no real subscription/node data.
!/docs/proxy-pool.example.json

# Collector and maintenance output, not source code or test fixtures.
/data_get/*.csv
/data_get/*.jsonl*
/data_get/local/*.csv
/data_processing/*.csv
/data_processing/title_translation*_results.jsonl*
/data_processing/aggregated_tags.txt
/data_processing/111.json
/data_processing/222.json
/tools/error.json
/tools/localimgtmp/

# Database snapshots and binary indexes; SQL schema/migration source is allowed.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.dump
*.sql.gz
*.sql.zip
*.sql.bz2
*.sql.xz
*.sql.zst
/*.sql
/gallery_info*.csv
/NH_info*.csv
/JM_info*.csv
*.pkl
*.pickle
*.faiss

# Import bundles / release archives may contain entire local databases.
/input_data/
input_data.zip*
XP-Gacha-*.zip*
XP-Gacha-*.7z*
XP-Gacha-*.tar*
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.zip.sha256
*.7z.sha256
*.tar.gz.sha256

# Logs, backups and crash dumps can retain secrets even after config is edited.
*.log
*.log.*
*.bak
*.bak.*
*.backup
*.backup.*
*.dmp

# Python bytecode and caches at any directory depth
/.venv/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/.coverage
/htmlcov/
**/__pycache__/
*.py[cod]
*$py.class

# Frontend dependencies and generated runtime packages.
node_modules/
/web/dist/
/.pnpm-store/
/.portable-cache/
*.tsbuildinfo

# macOS Finder metadata
.DS_Store
Thumbs.db
Desktop.ini
