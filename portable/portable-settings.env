# XP-Gacha portable optional settings.
# The application starts without editing this file. Lines beginning with # are ignored.

# Preferred ports. If occupied, the launcher automatically selects free ports.
XP_GACHA_PORT=8000
MYSQL_PORT=3307

# Relative paths are resolved from this portable package folder.
XP_GACHA_LIBRARY_PATH=library

# Interface/runtime limits.
XP_GACHA_IMPORT_MAX_MB=1024
MAX_DISPLAY=500

# Optional LLM and online services. Models and API services are not data-free runtime components.
LM_STUDIO_API_BASE=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=
LM_STUDIO_MODEL=local-model
ONLINE_API_BASE=
ONLINE_API_KEY=
ONLINE_MODEL=deepseek-v4-flash
# Optional proxy for online covers and NH collection. In the portable package, 127.0.0.1 is the Windows host.
ONLINE_COVER_PROXY=
ONLINE_COVER_FETCH_ENABLED=1
